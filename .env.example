IDEMPOTENCY_HASH_SECRET=replace-with-at-least-32-characters
CHALLENGE_HASH_SECRET=replace-with-at-least-32-characters
RATE_LIMIT_STORE=memory
REDIS_URL=redis://localhost:6379
JWT_ISSUER=https://auth.parc.invalid
JWT_ACTIVE_KID=development-ephemeral
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEYS_JSON=
TOKEN_HASH_SECRET=replace-with-at-least-32-characters
# KYC providers are chosen per capability: VERIFYME or PREMBLY.
KYC_IDENTITY_PROVIDER=PREMBLY
KYC_FACE_PROVIDER=PREMBLY
# Server-side secret key from the Prembly dashboard; never ship it to the app.
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=replace-with-prembly-secret-key
# Only needed for accounts that still issue an app ID.
# PREMBLY_APP_ID=replace-with-prembly-app-id
PREMBLY_CONFIGURATION_VERSION=prembly-production-v1
PREMBLY_TIMEOUT_MS=20000
# Face-match confidence Prembly must reach (70-100).
PREMBLY_FACE_MATCH_THRESHOLD=80
# Minimum liveness confidence, as a percentage.
PREMBLY_LIVENESS_MIN_PERCENT=90
# Development only: accept Prembly's canned sandbox data (test_ keys). Refused in production.
PREMBLY_ALLOW_SANDBOX=false
VERIFYME_BASE_URL=https://vapi.verifyme.ng
VERIFYME_API_KEY=replace-with-verifyme-api-key
VERIFYME_CONFIGURATION_VERSION=verifyme-production-v1
VERIFYME_TIMEOUT_MS=10000
KYC_IDENTIFIER_HASH_SECRET=replace-with-at-least-32-characters
KYC_IDENTIFIER_HASH_KEY_ID=kyc-hash-production-v1
KYC_RESULT_SIGNING_SECRET=replace-with-at-least-32-characters
KYC_RESULT_SIGNING_KEY_ID=kyc-signing-production-v1
NOTIFICATION_WORKER_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672
# Relays outbox events (OTP SMS/email requests) to RabbitMQ for the notification worker.
OUTBOX_PUBLISHER_ENABLED=false
# Comma-separated tenant UUIDs whose outbox rows this instance relays.
OUTBOX_TENANT_IDS=
OUTBOX_POLL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=1000
NOTIFICATION_TARGET_HASH_SECRET=replace-with-at-least-32-characters
NOTIFICATION_TARGET_HASH_KEY_ID=notification-target-production-v1
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Parc
BREVO_CONFIGURATION_VERSION=brevo-production-v1
TERMII_BASE_URL=https://replace-with-dashboard-base-url.example.com
TERMII_API_KEY=replace-with-termii-api-key
TERMII_SENDER_ID=Parc
TERMII_CHANNEL=generic
TERMII_CONFIGURATION_VERSION=termii-production-v1
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FCM_CONFIGURATION_VERSION=fcm-production-v1
