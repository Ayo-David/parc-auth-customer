{
  "name": "@parc/auth-customer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parc Auth & Customer service",
  "license": "UNLICENSED",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": "22.21.1",
    "yarn": "1.22.19"
  },
  "resolutions": {
    "uuid": "^11.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate:latest": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "migrate:status": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:status",
    "start": "node dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "typecheck": "tsc --noEmit",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "amqplib": "^2.0.1",
    "argon2": "^0.45.1",
    "express": "^5.1.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "redis": "^6.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
